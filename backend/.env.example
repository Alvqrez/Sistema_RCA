# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── Seguridad JWT (C-4) ───────────────────────────────────────────────────────
# OBLIGATORIO: genera un secreto largo y aleatorio, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS (M-1) ────────────────────────────────────────────────────────────────
# En producción: el dominio exacto del frontend (sin barra final).
# En desarrollo se permiten los orígenes locales comunes.
# Para múltiples orígenes separa con coma: http://a.com,http://b.com
CORS_ORIGIN=
